  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "multer": "^1.4.5-lts.2",
    "amqplib": "^0.10.5",
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "node-pg-migrate": "^7.9.1"
  },
  "engines": {
    "node": ">=22"
  }
