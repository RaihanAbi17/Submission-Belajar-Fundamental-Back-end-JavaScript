{
  "name": "openjob-api",
  "version": "2.0.0",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:dev": "node --watch server.js",
    "migrate:up": "node-pg-migrate up --migrations-dir migrations",
