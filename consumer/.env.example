# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=openjob

# JWT
ACCESS_TOKEN_KEY=replace_with_a_long_random_access_secret
REFRESH_TOKEN_KEY=replace_with_a_long_random_refresh_secret

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ (assessment-required variable names)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_QUEUE=openjob_applications

# SMTP/Nodemailer (configure real SMTP credentials for email tests)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
